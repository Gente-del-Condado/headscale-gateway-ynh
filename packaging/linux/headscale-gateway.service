[Unit]
Description=Headscale Gateway (tsnet, reverse proxy and SQLite admin)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gateway
Group=gateway
WorkingDirectory=/var/lib/headscale-gateway
ExecStart=/usr/local/bin/headscale-gateway -db /var/lib/headscale-gateway/gateway.sqlite
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/headscale-gateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
